{
  "name": "swarm-cursors",
  "version": "2.13.0",
  "description": "Blank the page, then a swarm of fake multiplayer cursors rebuilds it live \u2014 boxes, text, images, sound and sparks.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/swarm-cursors.mjs",
  "module": "./dist/swarm-cursors.mjs",
  "unpkg": "./dist/swarm-cursors.min.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/swarm-cursors.mjs",
      "default": "./dist/swarm-cursors.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run typecheck && node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
